{
	"name": "svelte-file-tree",
	"version": "0.20.0",
	"type": "module",
	"scripts": {
		"dev": "svelte-package --watch",
		"build": "svelte-package && publint",
		"prepack": "pnpm build",
		"check": "svelte-check",
		"check:watch": "svelte-check --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"peerDependencies": {
		"svelte": "^5.31.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.0",
		"publint": "^0.3.21",
		"svelte": "^5.31.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abdel-17/svelte-file-tree.git",
		"directory": "package"
	}
}
